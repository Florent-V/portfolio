{
    "name": "portfolio/florent",
    "description": "Portfolio",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Florent.V",
            "email": "florent@f5t.fr"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3.10.5",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.7",
        "easycorp/easyadmin-bundle": "^4.29.16",
        "gedmo/doctrine-extensions": "^3.22",
        "league/commonmark": "^2.10.4",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.2",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/ai-agent": "^0.9.0",
        "symfony/ai-brave-tool": "^0.9.0",
        "symfony/ai-bundle": "^0.9.0",
        "symfony/ai-gemini-platform": "^0.9.0",
        "symfony/ai-generic-platform": "^0.9.0",
        "symfony/ai-mistral-platform": "^0.9.0",
        "symfony/ai-open-router-platform": "^0.9.0",
        "symfony/ai-platform": "^0.9.0",
        "symfony/asset": "8.1.*",
        "symfony/brevo-mailer": "8.1.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-icons": "^2.36.1",
        "symfony/ux-live-component": "^2.36",
        "symfony/ux-turbo": "^2.36",
        "symfony/ux-twig-component": "^2.36",
        "symfony/ux-vue": "^2.36",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4.2",
        "symfony/yaml": "8.1.*",
        "symfonycasts/reset-password-bundle": "^1.25",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^3.24",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.27",
        "vich/uploader-bundle": "^2.9.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.2",
        "phpmd/phpmd": "^2.15",
        "phpro/grumphp": "^2.21",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.56",
        "phpstan/phpstan-symfony": "^2.0.18",
        "phpunit/phpunit": "^12.5.27",
        "squizlabs/php_codesniffer": "^3.13.6",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1.9",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "symplify/phpstan-rules": "^14.10",
        "vimeo/psalm": "^6.16.1",
        "vincentlanglet/twig-cs-fixer": "^3.14"
    }
}
