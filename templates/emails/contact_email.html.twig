<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Nouveau message de contact: {{ subject }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { width: 90%; max-width: 600px; margin: 20px auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px; }
        .header { background-color: #f4f4f4; padding: 10px; text-align: center; border-bottom: 1px solid #ddd; }
        .content { margin-top: 20px; }
        .content p { margin-bottom: 10px; }
        .label { font-weight: bold; }
        .footer { margin-top: 30px; text-align: center; font-size: 0.9em; color: #777; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2>Nouveau Message Depuis Votre Portfolio</h2>
    </div>
    <div class="content">
        <p><span class="label">De :</span> {{ name }} ({{ sender_email }})</p>
        <p><span class="label">Sujet :</span> {{ subject }}</p>
        <hr>
        <p><span class="label">Message :</span></p>
        <div>
            {{ message|nl2br }}
        </div>
    </div>
    <div class="footer">
        <p>Email envoyé depuis le formulaire de contact de votre portfolio.</p>
    </div>
</div>
</body>
</html>
