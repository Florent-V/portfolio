{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} — Florent Vasseur{% endblock %}

{% block meta_description %}{{ project.description|striptags|slice(0, 160) }}{% endblock %}

{% block og_image %}
    {% if project.mainImageName %}
        <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/projects/' ~ project.mainImageName) }}">
        <meta property="og:image:alt" content="{{ project.title }}">
        <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/projects/' ~ project.mainImageName) }}">
    {% endif %}
{% endblock %}

{% block json_ld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "{{ project.title|e('js') }}",
    "description": "{{ project.description|striptags|slice(0, 300)|e('js') }}",
    "url": "{{ project.slug ? url('app_project_show_by_slug', {slug: project.slug}) : url('app_project_show_by_id', {id: project.id}) }}",
    "author": {
        "@type": "Person",
        "name": "Florent Vasseur",
        "url": "{{ url('app_home') }}"
    },
    "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ url('app_home') }}"},
            {"@type": "ListItem", "position": 2, "name": "Projets", "item": "{{ url('app_project_index') }}"},
            {"@type": "ListItem", "position": 3, "name": "{{ project.title|e('js') }}", "item": "{{ project.slug ? url('app_project_show_by_slug', {slug: project.slug}) : url('app_project_show_by_id', {id: project.id}) }}"}
        ]
    }{% if project.startDate %},
    "dateCreated": "{{ project.startDate|date('Y-m-d') }}"{% endif %}{% if project.mainImageName %},
    "image": "{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/projects/' ~ project.mainImageName) }}"{% endif %}{% if project.url %},
    "sameAs": "{{ project.url }}"{% endif %}
}
</script>
{% endblock %}

{% block body %}
    <div
        {{ stimulus_controller('projectCarousel') }}
        class="bg-base-200 py-12 md:py-20 min-h-screen"
    >
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">

            <nav aria-label="Fil d'Ariane" class="max-w-4xl mx-auto mb-4 text-sm text-base-content/60">
                <ol class="flex flex-wrap items-center gap-1">
                    <li><a href="{{ path('app_home') }}" class="hover:text-primary transition-colors">Accueil</a></li>
                    <li aria-hidden="true" class="mx-1">/</li>
                    <li><a href="{{ path('app_project_index') }}" class="hover:text-primary transition-colors">Projets</a></li>
                    <li aria-hidden="true" class="mx-1">/</li>
                    <li aria-current="page" class="text-base-content font-medium truncate max-w-xs">{{ project.title }}</li>
                </ol>
            </nav>

            <article class="max-w-4xl mx-auto bg-base-100 shadow-xl rounded-lg overflow-hidden" data-aos="fade-up">

                {# Main Image or Carousel Start #}
                {% if project.projectImages is not empty %}
                    <div class="carousel-container w-full h-64 md:h-96 lg:h-[30rem] relative" data-aos="zoom-in">
                        <div class="carousel-wrapper w-full h-full overflow-hidden">
                            <div class="carousel-track flex transition-transform duration-300 ease-in-out" style="transform: translateX(0%);">
                                {# Include main image as the first item if it exists and different from gallery images #}
                                {% set mainImageDisplayedInGallery = false %}
                                {% for galleryImage in project.projectImages %}
                                    {% if galleryImage.imageName == project.mainImageName %}
                                        {% set mainImageDisplayedInGallery = true %}
                                    {% endif %}
                                {% endfor %}

                                {% if project.mainImageName and not mainImageDisplayedInGallery %}
                                    <div class="carousel-slide w-full h-full flex-shrink-0 flex justify-center items-center bg-base-300/20">
                                        <img src="{{ asset('uploads/images/projects/' ~ project.mainImageName) }}"
                                             alt="{{ 'common.main_project_image_alt'|trans({'%title%': project.title}) }}"
                                             {% if project.mainImageWidth %}width="{{ project.mainImageWidth }}" height="{{ project.mainImageHeight }}"{% endif %}
                                             loading="lazy"
                                             class="w-auto h-auto max-w-full max-h-full object-contain" />
                                    </div>
                                {% endif %}

                                {% for image in project.projectImages %}
                                    <div class="carousel-slide w-full h-full flex-shrink-0 flex justify-center items-center bg-base-300/20">
                                        <img src="{{ asset('uploads/images/projects/gallery/' ~ image.imageName) }}"
                                             alt="{{ image.altText|default('common.project_gallery_image_alt'|trans({'%project_title%': project.title, '%index%': loop.index})) }}"
                                             {% if image.imageWidth %}width="{{ image.imageWidth }}" height="{{ image.imageHeight }}"{% endif %}
                                             loading="lazy"
                                             class="w-auto h-auto max-w-full max-h-full object-contain" />
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Navigation Controls -->
                        <button class="carousel-prev absolute left-5 top-1/2 -translate-y-1/2 btn btn-circle btn-sm z-10 hover:bg-primary hover:text-primary-content transition-colors duration-200">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                        <button class="carousel-next absolute right-5 top-1/2 -translate-y-1/2 btn btn-circle btn-sm z-10 hover:bg-primary hover:text-primary-content transition-colors duration-200">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>

                        <!-- Dots Indicator -->
                        <div class="carousel-dots absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2">
                            {% set totalSlides = project.projectImages|length + ((project.mainImageName and not mainImageDisplayedInGallery) ? 1 : 0) %}
                            {% for i in 0..(totalSlides - 1) %}
                                <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-200 {{ loop.first ? 'bg-white' : '' }}" data-slide="{{ i }}"></button>
                            {% endfor %}
                        </div>
                    </div>
                {% elseif project.mainImageName %}
                    <figure class="h-64 md:h-96 lg:h-[30rem] w-full flex justify-center items-center bg-base-300/20" data-aos="zoom-in">
                        <img src="{{ asset('uploads/images/projects/' ~ project.mainImageName) }}"
                             alt="{{ 'common.main_project_image_alt'|trans({'%title%': project.title}) }}"
                             {% if project.mainImageWidth %}width="{{ project.mainImageWidth }}" height="{{ project.mainImageHeight }}"{% endif %}
                             loading="lazy"
                             class="w-auto h-auto max-w-full max-h-full object-contain">
                    </figure>
                {% endif %}
                {# Carousel End #}

                <div class="p-6 md:p-8 lg:p-10">
                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-4" data-aos="fade-left" data-aos-delay="100">{{ project.title }}</h1> {# From DB #}

                    <div class="text-sm text-base-content opacity-80 mb-6" data-aos="fade-left" data-aos-delay="200">
                        {% if project.startDate %}
                            <span class="mr-4"><strong class="font-semibold">{{ 'project.start_date'|trans }}</strong> {{ project.startDate|date('d M Y') }}</span>
                        {% endif %}
                        {% if project.endDate %}
                            <span><strong class="font-semibold">{{ 'project.end_date'|trans }}</strong> {{ project.endDate|date('d M Y') }}</span>
                        {% endif %}
                    </div>

                    <div class="prose lg:prose-lg max-w-none mb-8 text-base-content" data-aos="fade-up" data-aos-delay="300">
                        {{ project.description|raw }} {# From DB. Use |raw if HTML is intended #}
                    </div>

                    {% if project.technologies is not empty %}
                        <div class="mb-8" data-aos="fade-up" data-aos-delay="400">
                            <h3 class="text-lg md:text-xl font-semibold text-secondary mb-3">{{ 'project.tech_used'|trans }}</h3>
                            <div class="flex flex-wrap gap-2">
                                {% for tech in project.technologies %}
                                    <span class="badge badge-md lg:badge-lg badge-outline" data-aos="zoom-in" data-aos-delay="{{ 500 + loop.index0 * 50 }}">
                                    {% if tech.imageName %}
                                        <img src="{{ asset('uploads/images/technologies/' ~ tech.imageName) }}" alt="{{ tech.name }}" loading="lazy" class="h-4 w-4 mr-1.5 object-contain">
                                    {% endif %}
                                        {{ tech.name }} {# From DB #}
                                </span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap gap-4 mb-8" data-aos="fade-up" data-aos-delay="500">
                        {% if project.url %}
                            <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-md">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                {{ 'project.live_site'|trans }}
                            </a>
                        {% endif %}
                        {% if project.repositoryUrl %}
                            <a href="{{ project.repositoryUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-secondary btn-md">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                {{ 'project.source_code'|trans }}
                            </a>
                        {% endif %}
                    </div>

                    {% if relatedArticles is defined and relatedArticles is not empty %}
                        <div class="border-t pt-8 mt-8" data-aos="fade-up" data-aos-delay="650">
                            <h2 class="text-xl font-semibold text-secondary mb-4">Articles liés</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                {% for relatedArticle in relatedArticles %}
                                    <a href="{{ path('app_article_show', {slug: relatedArticle.slug}) }}"
                                       class="flex items-start gap-3 p-4 rounded-lg bg-base-200 hover:bg-base-300 transition-colors group">
                                        {% if relatedArticle.mainImageName %}
                                            <img src="{{ asset('uploads/images/articles/' ~ relatedArticle.mainImageName) }}"
                                                 alt="{{ relatedArticle.title }}"
                                                 loading="lazy"
                                                 class="w-16 h-16 object-cover rounded shrink-0">
                                        {% endif %}
                                        <div class="min-w-0">
                                            <p class="font-medium text-base-content group-hover:text-primary transition-colors line-clamp-2">{{ relatedArticle.title }}</p>
                                            {% if relatedArticle.publishedAt %}
                                                <p class="text-xs text-base-content/60 mt-1">{{ relatedArticle.publishedAt|date('d M Y') }}</p>
                                            {% endif %}
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% if latestProjects is defined and latestProjects is not empty %}
                        <div class="border-t pt-6 mt-6" data-aos="fade-up" data-aos-delay="675">
                            <h2 class="text-xl font-semibold text-secondary mb-4">À découvrir aussi</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                {% for latestProject in latestProjects %}
                                    <a href="{{ path('app_project_show_by_slug', {slug: latestProject.slug}) }}"
                                       class="flex items-start gap-3 p-4 rounded-lg bg-base-200 hover:bg-base-300 transition-colors group">
                                        {% if latestProject.mainImageName %}
                                            <img src="{{ asset('uploads/images/projects/' ~ latestProject.mainImageName) }}"
                                                 alt="{{ latestProject.title }}"
                                                 loading="lazy"
                                                 class="w-16 h-16 object-cover rounded shrink-0">
                                        {% endif %}
                                        <div class="min-w-0">
                                            <p class="font-medium text-base-content group-hover:text-primary transition-colors line-clamp-2">{{ latestProject.title }}</p>
                                            {% if latestProject.startDate %}
                                                <p class="text-xs text-base-content/60 mt-1">{{ latestProject.startDate|date('Y') }}</p>
                                            {% endif %}
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="text-center border-t pt-6 mt-6" data-aos="fade-up" data-aos-delay="700">
                        <a href="{{ path('app_project_index') }}" class="btn btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
                            {{ 'project.back_to_projects'|trans }}
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </div>
{% endblock %}
