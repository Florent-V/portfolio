{% extends 'base_error.html.twig' %}
{% block title %}Erreur 401 - Non autorisé{% endblock %}
{% block body %}
<div class="min-h-screen flex flex-col items-center justify-center bg-base-200">
    <div class="bg-base-100 shadow-xl rounded-lg p-10 text-center max-w-lg">
        <h1 class="text-7xl font-black text-secondary mb-4">401</h1>
        <p class="text-xl font-semibold mb-2 text-base-content">Non autorisé !</p>
        <p class="mb-6 text-base-content/80">Tu n'as pas le droit d'accéder à cette ressource.<br>Il faut montrer patte blanche&nbsp;!</p>
        <a href="/" class="btn btn-secondary">Retour à l'accueil</a>
    </div>
    <p class="mt-8 text-base-content/60">Même les chats ont parfois besoin d'une invitation.</p>
</div>
{% endblock %}
