{% extends 'base_error.html.twig' %}
{% block title %}Erreur 404 - Page introuvable{% endblock %}
{% block body %}
<div class="min-h-full flex flex-col items-center justify-center bg-base-200">
    <div class="bg-base-100 shadow-xl rounded-lg p-10 text-center max-w-lg">
        <h1 class="text-7xl font-black text-info mb-4">404</h1>
        <p class="text-xl font-semibold mb-2 text-base-content">Page introuvable !</p>
        <p class="mb-6 text-base-content/80">La page que tu cherches n'existe pas.<br>Ou alors elle s'est cachée très loin&nbsp;!</p>
        <a href="/" class="btn btn-info">Retour à l'accueil</a>
    </div>
    <p class="mt-8 text-base-content/60">Erreur 404 : Page perdue dans le multivers.</p>
</div>
{% endblock %}
