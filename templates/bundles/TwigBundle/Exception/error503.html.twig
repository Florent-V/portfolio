{% extends 'base_error.html.twig' %}
{% block title %}Erreur 503 - Service indisponible{% endblock %}
{% block body %}
<div class="min-h-full flex flex-col items-center justify-center bg-base-200">
  <div class="bg-base-100 shadow-xl rounded-lg p-10 text-center max-w-lg">
    <h1 class="text-7xl font-black text-warning mb-4">503</h1>
    <p class="text-xl font-semibold mb-2 text-base-content">Service indisponible !</p>
    <p class="mb-6 text-base-content/80">Le service fait une sieste.<br>Revenez plus tard, ou offrez-lui un café !</p>
    <a href="/" class="btn btn-warning">Retour à l'accueil</a>
  </div>
  <p class="mt-8 text-base-content/60">Les chats serveurs dorment profondément 😴</p>
</div>
{% endblock %}
