{% extends 'base_error.html.twig' %}
{% block title %}Erreur 400 - Mauvaise requête{% endblock %}
{% block body %}
<div class="min-h-full flex flex-col items-center justify-center bg-base-200">
    <div class="bg-base-100 shadow-xl rounded-lg p-10 text-center max-w-lg">
        <h1 class="text-7xl font-black text-warning mb-4">400</h1>
        <p class="text-xl font-semibold mb-2 text-base-content">Oups ! Mauvaise requête</p>
        <p class="mb-6 text-base-content/80">On dirait que ta requête n'a pas été comprise.<br>Essaie encore&nbsp;!</p>
        <a href="/" class="btn btn-warning">Retour à l'accueil</a>
    </div>
    <p class="mt-8 text-base-content/60">Même les robots font des fautes de frappe.</p>
</div>
{% endblock %}
