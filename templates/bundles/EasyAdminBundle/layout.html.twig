{% extends '@!EasyAdmin/layout.html.twig' %}

{% block head_metas %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
    (function () {
        document.addEventListener('turbo:before-visit', function (e) {
            e.preventDefault();
            window.location.href = e.detail.url;
        });
    })();
    </script>
{% endblock %}
