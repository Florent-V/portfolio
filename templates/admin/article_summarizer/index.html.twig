{% extends 'base.html.twig' %}

{% block title %}Résumé IA — {{ article.title }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200 py-10">
    <div class="max-w-2xl mx-auto px-4">

        <div class="breadcrumbs text-sm mb-6">
            <ul>
                <li><a href="{{ path('admin') }}">Administration</a></li>
                <li>
                    <a href="{{ path('admin', {crudAction: 'edit', crudControllerFqcn: 'App\\Controller\\Admin\\ArticleCrudController', entityId: article.id}) }}">
                        {{ article.title|u.truncate(40, '…') }}
                    </a>
                </li>
                <li>Résumé IA</li>
            </ul>
        </div>

        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center shrink-0">
                <twig:ux:icon name="lucide:wand-sparkles" height="32" width="32" />
            </div>
            <div>
                <h1 class="text-2xl font-bold text-base-content">Générer un résumé IA</h1>
                <p class="text-sm text-base-content/60 truncate max-w-xs">{{ article.title }}</p>
            </div>
        </div>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div role="alert" class="alert {{ type == 'danger' ? 'alert-error' : 'alert-success' }} mb-4">
                    <i class="fa fa-{{ type == 'danger' ? 'circle-xmark' : 'circle-check' }}"></i>
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="btn btn-ghost btn-xs ml-auto">✕</button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-8 space-y-6">

                <div class="alert alert-info">
                    <i class="fa fa-circle-info"></i>
                    <span class="text-sm">
                        L'IA analyse l'article et génère <strong>3 points clés</strong> en liste HTML.
                        Un résumé existant sera <strong>remplacé</strong>.
                    </span>
                </div>

                {{ form_start(form) }}

                <div class="form-control">
                    {{ form_label(form.provider, null, {label_attr: {class: 'block font-medium mb-1 text-base-content'}}) }}
                    {{ form_widget(form.provider, {attr: {class: 'select select-bordered w-full'}}) }}
                    {{ form_errors(form.provider) }}
                </div>

                <div class="divider"></div>

                <div class="flex items-center justify-between">
                    <a href="{{ path('admin', {crudAction: 'edit', crudControllerFqcn: 'App\\Controller\\Admin\\ArticleCrudController', entityId: article.id}) }}"
                       class="btn btn-outline gap-2">
                        <i class="fa fa-arrow-left"></i>Retour à l'article
                    </a>
                    {{ form_widget(form.submit, {attr: {class: 'btn btn-secondary gap-2'}}) }}
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="alert mt-4 bg-base-100 border border-warning/40">
            <i class="fa fa-clock text-warning"></i>
            <span class="text-sm text-base-content/70">
                <strong>Temps estimé :</strong> 5–20 secondes.
            </span>
        </div>

    </div>
</div>

<div id="ai-loader" class="hidden fixed inset-0 bg-black/70 z-[9999] flex flex-col items-center justify-center gap-5">
    <span class="loading loading-spinner loading-lg text-primary"></span>
    <div class="text-center">
        <p class="text-white font-bold text-lg">Génération du résumé en cours…</p>
        <p class="text-white/60 text-sm mt-1">Analyse du contenu de l'article</p>
    </div>
</div>

<script>
(function () {
    var loader = document.getElementById('ai-loader');
    var form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function () {
            loader.classList.remove('hidden');
            loader.classList.add('flex');
        });
    }
})();
</script>
{% endblock %}
