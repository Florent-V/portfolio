{% extends 'base.html.twig' %}

{% block title %}Importer un article JSON{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200 py-10">
    <div class="max-w-3xl mx-auto px-4">

        <div class="breadcrumbs text-sm mb-6">
            <ul>
                <li><a href="{{ path('admin') }}">Administration</a></li>
                <li>Importer un article JSON</li>
            </ul>
        </div>

        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <twig:ux:icon name="mingcute:file-import-line" height="32" width="32" />
            </div>
            <div>
                <h1 class="text-2xl font-bold text-base-content">Importer un article JSON</h1>
                <p class="text-sm text-base-content/60">Importez un fichier généré par les fonctions IA</p>
            </div>
        </div>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div role="alert" class="alert {{ type == 'danger' ? 'alert-error' : (type == 'success' ? 'alert-success' : 'alert-info') }} mb-4">
                    <i class="fa fa-{{ type == 'danger' ? 'circle-xmark' : (type == 'success' ? 'circle-check' : 'circle-info') }}"></i>
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="btn btn-ghost btn-xs ml-auto">✕</button>
                </div>
            {% endfor %}
        {% endfor %}

        {% set jsonFileErrors = [] %}
        {% for error in form.jsonFile.vars.errors %}
            {% set jsonFileErrors = jsonFileErrors|merge([error.message]) %}
        {% endfor %}

        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-8 space-y-6">

                {{ form_start(form, {attr: {id: 'import-form', enctype: 'multipart/form-data'}}) }}

                <div class="hidden">
                    {{ form_widget(form.jsonFile) }}
                    {{ form_widget(form.submit) }}
                </div>

                <div {{ vue_component('JsonImport', {
                    inputId: form.jsonFile.vars.id,
                    submitId: form.submit.vars.id,
                    initialErrors: jsonFileErrors,
                }) }}>
                    <div class="flex items-center justify-center p-10">
                        <span class="loading loading-spinner loading-lg text-primary"></span>
                    </div>
                </div>

                <div class="divider"></div>

                <a href="{{ path('admin') }}" class="btn btn-outline gap-2">
                    <i class="fa fa-arrow-left"></i>Retour
                </a>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="alert mt-4 bg-base-100 border border-info/40">
            <i class="fa fa-circle-info text-info"></i>
            <span class="text-sm text-base-content/70 font-mono">
                Format : <code>{ "title": "...", "slug": "...", "content_blocks": [...] }</code>
            </span>
        </div>

    </div>
</div>
{% endblock %}
