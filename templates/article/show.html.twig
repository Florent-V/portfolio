{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} — Florent Vasseur{% endblock %}

{% block meta_description %}{% set firstContent = article.contentElements|first %}{% if firstContent is not null %}{{ firstContent.content|striptags|slice(0, 155) }}{% else %}{{ article.title }} — Article de Florent Vasseur sur le développement web Symfony et PHP.{% endif %}{% endblock %}

{% block og_type %}article{% endblock %}

{% block og_image %}
    {% if article.mainImageName %}
        <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/articles/' ~ article.mainImageName) }}">
        <meta property="og:image:alt" content="{{ article.title }}">
        <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/articles/' ~ article.mainImageName) }}">
    {% endif %}
{% endblock %}

{% block json_ld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ article.title|e('js') }}",
    "url": "{{ url('app_article_show', {slug: article.slug}) }}",
    "datePublished": "{{ article.publishedAt|date('c') }}",
    "dateModified": "{{ article.updatedAt|date('c') }}",
    "author": {
        "@type": "Person",
        "name": "Florent Vasseur",
        "url": "{{ url('app_home') }}"
    },
    "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ url('app_home') }}"},
            {"@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ url('app_article_index') }}"},
            {"@type": "ListItem", "position": 3, "name": "{{ article.title|e('js') }}", "item": "{{ url('app_article_show', {slug: article.slug}) }}"}
        ]
    }{% if article.mainImageName %},
    "image": "{{ app.request.schemeAndHttpHost }}{{ asset('uploads/images/articles/' ~ article.mainImageName) }}"{% endif %}
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
{% endblock %}

{% block body %}
    {% if isPreview is defined and isPreview %}
        <div class="sticky top-0 z-50 bg-warning text-warning-content text-center py-2 px-4 text-sm font-semibold flex items-center justify-center gap-2 shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            Mode prévisualisation — cet article n'est pas encore publié
            <a href="{{ path('admin_article_edit', {entityId: article.id}) }}" class="underline ml-2 font-bold">Retour à l'édition</a>
        </div>
    {% endif %}
    <div class="bg-base-200 py-12 md:py-20 min-h-screen">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">

            <nav aria-label="Fil d'Ariane" class="max-w-5xl mx-auto mb-4 text-sm text-base-content/60">
                <ol class="flex flex-wrap items-center gap-1">
                    <li><a href="{{ path('app_home') }}" class="hover:text-primary transition-colors">Accueil</a></li>
                    <li aria-hidden="true" class="mx-1">/</li>
                    <li><a href="{{ path('app_article_index') }}" class="hover:text-primary transition-colors">Blog</a></li>
                    <li aria-hidden="true" class="mx-1">/</li>
                    <li aria-current="page" class="text-base-content font-medium truncate max-w-xs">{{ article.title }}</li>
                </ol>
            </nav>

            <article class="max-w-5xl mx-auto bg-base-100 shadow-xl rounded-lg overflow-hidden" data-aos="fade-up">

                {% if article.mainImageName %}
                    <figure class="h-64 md:h-80 lg:h-96 w-full" data-aos="zoom-in">
                        <img src="{{ asset('uploads/images/articles/' ~ article.mainImageName) }}"
                             alt="{{ 'common.main_article_image_alt'|trans({'%title%': article.title}) }}"
                             {% if article.mainImageWidth %}width="{{ article.mainImageWidth }}" height="{{ article.mainImageHeight }}"{% endif %}
                             loading="lazy"
                             class="object-cover w-full h-full">
                    </figure>
                {% endif %}

                <div class="p-6 md:p-8 lg:p-10">
                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-2" data-aos="fade-left" data-aos-delay="100">{{ article.title }}</h1>

                    <div class="text-sm text-base-content opacity-70 mb-6" data-aos="fade-left" data-aos-delay="200">
                        <span>{{ 'article.published_on'|trans }} {{ article.publishedAt|date('d F Y à H:i') }}</span>
                        {% if article.author %}
                            <span>{{ 'article.by_author'|trans }} <a href="#" class="link link-hover">{{ article.author.userName|default(article.author.firstName ~ ' ' ~ article.author.lastName) }}</a></span>
                        {% endif %}
                    </div>

                    {% set summaryBlocks = article.contentElements|filter(e => e.type.value == 'summary') %}
                    {% set contentBlocks = article.contentElements|filter(e => e.type.value != 'summary') %}

                    {% for element in summaryBlocks %}
                        <div class="bg-base-200 border-l-4 border-primary rounded-lg p-5 mb-6" data-aos="fade-up" data-aos-delay="250">
                            <h3 class="text-sm font-bold text-primary uppercase tracking-wide mb-3 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                                Points clés
                            </h3>
                            <div class="text-base-content text-sm [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-2 [&_strong]:text-primary">
                                {{ element.content|raw }}
                            </div>
                        </div>
                    {% endfor %}

                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8" data-aos="fade-up" data-aos-delay="300">
                        {% for element in contentBlocks %}
                            {% set spanClass = element.columnSpan.value == 'one_third' ? 'xl:col-span-1' : (element.columnSpan.value == 'two_thirds' ? 'xl:col-span-2' : 'xl:col-span-3') %}
                            <div class="col-span-1 {{ spanClass }}">
                                {% if element.type.value == 'paragraph' %}
                                    <div class="prose lg:prose-lg xl:prose-xl max-w-none text-base-content">
                                        {{ element.content|raw }}
                                    </div>
                                {% elseif element.type.value == 'image' and element.imageName %}
                                    <figure>
                                        <img src="{{ asset('uploads/images/articles/' ~ element.imageName) }}"
                                             alt="{{ element.altText ?? '' }}"
                                             class="w-full rounded-lg shadow-lg">
                                        {% if element.altText %}
                                            <figcaption class="text-center text-sm text-gray-500 mt-2">{{ element.altText }}</figcaption>
                                        {% endif %}
                                    </figure>
                                {% elseif element.type.value == 'code' and element.content %}
                                    <pre class="rounded-lg overflow-x-auto"><code class="language-{{ element.language ?? 'plaintext' }}">{{ element.content|replace({'</p>': '\n', '<br>': '\n', '<br/>': '\n', '<br />': '\n', '</div>': '\n'})|striptags|trim|raw }}</code></pre>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>

                    {% if article.tags is not empty %}
                        <div class="mb-8" data-aos="fade-up" data-aos-delay="400">
                            <h3 class="text-lg md:text-xl font-semibold text-secondary mb-3">{{ 'article.tags'|trans }}</h3>
                            <div class="flex flex-wrap gap-2">
                                {% for tag in article.tags %}
                                    <span class="badge badge-md lg:badge-lg badge-outline" data-aos="zoom-in" data-aos-delay="{{ 500 + loop.index0 * 50 }}">
                                        {{ tag.name }}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% if relatedProjects is defined and relatedProjects is not empty %}
                        <div class="border-t pt-8 mt-8" data-aos="fade-up" data-aos-delay="650">
                            <h2 class="text-xl font-semibold text-secondary mb-4">Projets liés</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                {% for relatedProject in relatedProjects %}
                                    <a href="{{ path('app_project_show_by_slug', {slug: relatedProject.slug}) }}"
                                       class="flex items-start gap-3 p-4 rounded-lg bg-base-200 hover:bg-base-300 transition-colors group">
                                        {% if relatedProject.mainImageName %}
                                            <img src="{{ asset('uploads/images/projects/' ~ relatedProject.mainImageName) }}"
                                                 alt="{{ relatedProject.title }}"
                                                 loading="lazy"
                                                 class="w-16 h-16 object-cover rounded shrink-0">
                                        {% endif %}
                                        <div class="min-w-0">
                                            <p class="font-medium text-base-content group-hover:text-primary transition-colors line-clamp-2">{{ relatedProject.title }}</p>
                                            {% if relatedProject.startDate %}
                                                <p class="text-xs text-base-content/60 mt-1">{{ relatedProject.startDate|date('Y') }}</p>
                                            {% endif %}
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="text-center border-t pt-8 mt-8" data-aos="fade-up" data-aos-delay="700">
                        <a href="{{ path('app_article_index') }}" class="btn btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
                            {{ 'article.back_to_articles'|trans }}
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </div>
    <script>document.addEventListener('DOMContentLoaded', () => hljs.highlightAll());</script>
{% endblock %}
