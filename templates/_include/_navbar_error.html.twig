{#
    Navbar allégée dédiée aux pages d'erreur (TwigBundle/Exception).
    Volontairement dépourvue de toute dépendance risquant de déclencher
    une nouvelle exception (pas d'accès DB via aboutMe, pas d'app.user,
    pas d'is_granted, pas d'avatar vich_uploader) : uniquement du routing
    statique et du JS côté client (thème via localStorage).
#}
<nav
    {{ stimulus_controller(' toggleDarkMode') }}
    class="bg-base-100 shadow-md sticky top-0 z-50"
>
    <div class="container">
        <div class="flex justify-between items-center h-16 gap-8">
            <div class="flex-shrink-0">
                <a href="{{ path('app_home') }}" class="ml-3 text-xl font-bold text-base-content hover:text-primary">
                    {{ 'navbar.home'|trans }}
                </a>
            </div>

            <div class="hidden lg:flex flex-grow justify-around items-center">
                <a href="{{ path('app_project_index') }}"
                   class="text-base-content hover:text-primary text-center py-2 rounded-md text font-medium">{{ 'navbar.projects'|trans }}</a>
                <a href="{{ path('app_article_index') }}"
                   class="text-base-content hover:text-primary text-center py-2 rounded-md text font-medium">{{ 'navbar.articles'|trans }}</a>
                <a href="{{ path('app_home') }}#contact"
                   class="text-base-content hover:text-primary text-center py-2 rounded-md text font-medium">{{ 'navbar.contact'|trans }}</a>
            </div>

            <div class="flex items-center">
                <div class="hidden lg:flex items-center gap-2">
                    <div class="dropdown dropdown-end mr-1 lg:mr-2">
                        <label tabindex="0" class="btn btn-ghost btn-sm lg:btn-md p-0 px-2"
                               title="{{ 'common.language_switcher.title'|trans }}">
                            {% set current_locale = app.request.locale %}
                            {% if current_locale == 'fr' %}
                                <twig:ux:icon name="emojione-v1:flag-for-france" height="26" width="26" class="mr-2" />
                                <span class="hidden sm:inline">FR</span>
                            {% elseif current_locale == 'en' %}
                                <twig:ux:icon name="twemoji:flag-united-kingdom" height="26" width="26" class="mr-2"/>
                                <span class="hidden sm:inline">EN</span>
                            {% endif %}
                            <svg class="w-2.5 h-2.5 ml-0.5 sm:ml-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                                 fill="none" viewBox="0 0 10 6">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="m1 1 4 4 4-4" />
                            </svg>
                        </label>
                        <ul tabindex="0"
                            class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-40 mt-2">
                            <li><a href="{{ path('app_switch_locale', {locale: 'fr'}) }}"
                                   class="{{ app.request.locale == 'fr' ? 'font-bold text-primary' : '' }}">
                                    <twig:ux:icon name="emojione-v1:flag-for-france" height="26" width="26" class="mr-2"/> Français
                                </a></li>
                            <li><a href="{{ path('app_switch_locale', {locale: 'en'}) }}"
                                   class="{{ app.request.locale == 'en' ? 'font-bold text-primary' : '' }}">
                                    <twig:ux:icon name="twemoji:flag-united-kingdom" height="26" width="26" class="mr-2"/>English</a></li>
                        </ul>
                    </div>

                    <label class="swap swap-rotate btn btn-ghost btn-sm lg:btn-md mr-1 lg:mr-2 p-0"
                           title="{{ 'common.theme_toggle.toggle'|trans }}">
                        <input type="checkbox" id="theme-toggle-checkbox" class="theme-controller" />
                        <svg id="theme-toggle-sun" class="swap-off fill-current w-5 h-5 lg:w-6 lg:h-6"
                             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <title>{{ 'common.theme_toggle.light'|trans }}</title>
                            <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29l.71-.71a1,1,0,0,0,-1.41-1.41l-.71.71A1,1,0,0,0,5.64,7.05ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM20,12a1,1,0,0,0-1-1H18a1,1,0,0,0,0,2h1A1,1,0,0,0,20,12ZM17,5.64a1,1,0,0,0,.71-.29l.71-.71a1,1,1,0,0,-1.41-1.41l-.71.71A1,1,0,0,0,17,5.64ZM12,15a3,3,0,1,0-3-3A3,3,0,0,0,12,15Zm0,2a5,5,0,1,0-5-5A5,5,0,0,0,12,17Z" />
                        </svg>
                        <svg id="theme-toggle-moon" class="swap-on fill-current w-5 h-5 lg:w-6 lg:h-6"
                             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <title>{{ 'common.theme_toggle.dark'|trans }}</title>
                            <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22a10.14,10.14,0,0,0,9.55,9.55A8.14,8.14,0,0,1,12.14,19.73Z" />
                        </svg>
                    </label>
                </div>

                <div class="lg:hidden">
                    <button id="mobile-menu-button"
                            class="btn btn-ghost btn-sm lg:btn-md inline-flex items-center justify-center p-1 rounded-md text-base-content hover:text-primary hover:bg-base-200 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary"
                            aria-controls="mobile-menu" aria-expanded="false">
                        <span class="sr-only">{{ 'common.open_main_menu'|trans }}</span>
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="lg:hidden hidden" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <a href="{{ path('app_project_index') }}"
               class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.projects'|trans }}</a>
            <a href="{{ path('app_article_index') }}"
               class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.articles'|trans }}</a>
            <a href="{{ path('app_home') }}#contact"
               class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.contact'|trans }}</a>
        </div>
    </div>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('mobile-menu-button')
    const mobileMenu = document.getElementById('mobile-menu')
    if (!menuButton || !mobileMenu) return
    const svgs = menuButton.querySelectorAll('svg')

    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden')
      svgs.forEach(svg => svg.classList.toggle('hidden'))
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true' || false
      menuButton.setAttribute('aria-expanded', !isExpanded)
    })
  })
</script>
