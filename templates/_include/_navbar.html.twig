                        <img class="h-10 w-10 rounded-full" src="{{ app.user.picture ? vich_uploader_asset(app.user, 'pictureFile') : asset('build/images/default_profil_picture.png') }}" alt="Avatar">
                    </div>
                    <div class="ml-3">
                        <div class="text-base font-medium leading-none text-base-content">{{ app.user.userName }}</div>
