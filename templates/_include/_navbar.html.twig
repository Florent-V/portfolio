            <a href="{{ path('app_home') }}#skills" class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.skills'|trans }}</a>
            <a href="{{ path('app_project_index') }}" class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.projects'|trans }}</a>
            <a href="{{ path('app_article_index') }}" class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.articles'|trans }}</a>
            <a href="{{ path('app_home') }}#experience" class="text-base-content hover:text-primary block px-3 py-2 rounded-md text-base font-medium">{{ 'navbar.experience'|trans }}</a>
