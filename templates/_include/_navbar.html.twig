<nav class="bg-base-100 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo et Titre -->
            <div class="flex items-center">
                <img class="h-8 w-8" src="https://placehold.co/600x400" alt="Logo">
                <span class="ml-3 text-xl font-bold text-base-content">SaaSApp</span>
            </div>

            <!-- Liens de Navigation -->
            <div class="hidden md:flex space-x-8">
                <a href="/" class="text-base-content hover:text-primary px-3 py-2 rounded-md text-sm font-medium">Accueil</a>
                <a href="/product" class="text-base-content hover:text-primary px-3 py-2 rounded-md text-sm font-medium">Fonctionnalités</a>
                <a href="#" class="text-base-content hover:text-primary px-3 py-2 rounded-md text-sm font-medium">Tarifs</a>
                <a href="#" class="text-base-content hover:text-primary px-3 py-2 rounded-md text-sm font-medium">Contact</a>
            </div>

            <!-- Bouton CTA et Connexion -->
            <div class="flex items-center">
                <a href="{{ path('app_register') }}" class="btn btn-primary">Essai Gratuit</a>

                <!-- Si l'utilisateur est connecté -->
                {% if app.user %}
                    <div class="dropdown dropdown-end ml-4">
                        <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                            <div class="w-10 rounded-full">
                                <img src="{{ app.user.picture ? vich_uploader_asset(app.user, 'pictureFile') : asset('build/images/default_profil_picture.png') }}" alt="Avatar">
                            </div>
                        </label>
                        <ul tabindex="0" class="mt-3 p-2 shadow menu menu-compact dropdown-content bg-base-100 rounded-box w-52">
                            <li>
                                <a href="{{ path('app_user_account') }}" class="justify-between">Votre Profil</a>
                            </li>
                            <li><a>Paramètres</a></li>
                            <li>
                                <a href="{{ path('app_change_password') }}" class="justify-between">Changer le mot de passe</a>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a href="{{ path('admin') }}">Tableau de bord Admin</a></li>
                            {% endif %}
                            <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                        </ul>
                    </div>
                {% else %}
                    <!-- Si l'utilisateur n'est PAS connecté -->
                    <div class="ml-4 space-x-2 flex">
                        <a href="{{ path('app_login') }}" class="btn btn-outline btn-primary">Se connecter</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary">S'inscrire</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
