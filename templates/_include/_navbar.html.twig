            <!-- Espace réservé pour le menu utilisateur si l'admin est connecté (Desktop) -->
            <div class="hidden md:flex items-center">
                {% if app.user and is_granted('ROLE_ADMIN') %}
                    <div class="dropdown dropdown-end ml-2"> {# Reduced margin if lang switcher takes space #}
                        <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                            <div class="w-10 rounded-full">
                                <img src="{{ app.user.picture ? vich_uploader_asset(app.user, 'pictureFile') : asset('build/images/default_profil_picture.png') }}" alt="Avatar">
