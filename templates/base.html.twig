<!DOCTYPE html>
<html lang="{{ app.request.locale }}"
      prefix="og: https://ogp.me/ns#">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="turbo-cache-control" content="no-cache">

        {# Meta tags pour PWA #}
        <meta name="theme-color" content="#4285f4">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="mobile-web-app-status-bar-style" content="black">
        <meta name="mobile-web-app-title" content="Florent Vasseur">

        {# Manifest PWA #}
        <link rel="manifest" href="{{ asset('/manifest.json') }}">

        {# Icônes Apple #}
        <link rel="apple-touch-icon" href="{{ asset('build/pwa/icons/icon-192x192.png') }}">
        <link rel="apple-touch-icon" sizes="152x152" href="{{ asset('build/pwa/icons/icon-152x152.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/pwa/icons/icon-192x192.png') }}">
        <link rel="apple-touch-icon" sizes="167x167" href="{{ asset('build/pwa/icons/icon-152x152.png') }}">

        {# CSS pour les écrans de chargement pour iOS #}
        <style>
            body {
                -webkit-user-select: none;
                -webkit-tap-highlight-color: transparent;
                -webkit-touch-callout: none;
            }
        </style>

        <title>{% block title %}Florent Vasseur — Développeur Web{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Portfolio de Florent Vasseur, développeur web full-stack spécialisé Symfony et PHP.{% endblock %}">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost }}{{ app.request.pathInfo }}">

        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost }}{{ app.request.pathInfo }}">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:locale" content="{{ app.request.locale == 'fr' ? 'fr_FR' : 'en_US' }}">
        <meta property="og:site_name" content="Florent Vasseur">
        {% block og_image %}{% endblock %}

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        {% block twitter_image %}{% endblock %}

        {% block json_ld %}{% endblock %}

        <link rel="icon" type="image/png" href="{{ asset('build/images/icons/favicon.ico') }}"/>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        <script>
          // Theme switcher logic (keep as is)
          // console.log('localStorage.getItem(\'theme\')', localStorage.getItem('theme'));
          document.documentElement.setAttribute(
            'data-theme', localStorage.getItem('theme') || 'dark' // Default theme can be 'light', 'dark', or any DaisyUI theme
          );
        </script>
    </head>

    <body
            class="min-h-screen flex flex-col"
            {{ stimulus_controller(' deleteAlert') }}
    >
        {# Section pour le menu de navigation #}
        {{ include('_include/_navbar.html.twig') }}

        {# Contenu principal de la page #}
        <div class="flex-grow flex flex-col">
            {% block body %}{% endblock %}
        </div>

        {# Section pour les messages flash #}
        {{ include('_include/_flash_message.html.twig') }}

    </body>
</html>
