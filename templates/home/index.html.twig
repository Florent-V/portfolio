{% extends 'base.html.twig' %}

{% block title %}
    {% if aboutMe.title is defined and aboutMe.title is not empty %}
        {{ aboutMe.title|split(' - ')|first }} - Portfolio
    {% else %}
        {{ 'common.default_portfolio_title'|trans }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="bg-base-200 text-base-content">

        <!-- Hero Section -->
        <section id="hero" class="min-h-screen flex items-center justify-center bg-base-100">
            <div class="p-8 md:p-12 rounded-lg text-center max-w-3xl mx-auto">
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-base-content mb-6" data-aos="zoom-in-down">
                    {% if aboutMe.title is defined and aboutMe.title is not empty %}
{#                        {{ aboutMe.title|split(' - ')|first }}#}
                        {{ aboutMe.title }}
                    {% else %}
                        {{ 'hero.welcome_default'|trans }}
                    {% endif %}
                </h1>
                <p class="text-lg sm:text-xl text-base-content mb-8" data-aos="fade-up" data-aos-delay="200">
                    {% if aboutMe.description is defined and aboutMe.description is not empty %}
                        {{ aboutMe.description|striptags|slice(0, 200) }}{% if aboutMe.description|striptags|length > 200 %}...{% endif %}
                    {% else %}
                        {{ 'hero.passionate_developer'|trans }}
                    {% endif %}
                </p>
                <div data-aos="fade-up" data-aos-delay="400">
                    <a href="#about" class="btn btn-primary btn-lg m-2">{{ 'hero.learn_more'|trans }}</a>
                    {% if aboutMe.cvFileName is defined and aboutMe.cvFileName is not null %}
                        <a href="{{ asset('uploads/files/cv/' ~ aboutMe.cvFileName) }}" target="_blank" class="btn btn-outline btn-secondary btn-lg m-2">{{ 'hero.download_cv'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- About Me Section -->
        <section id="about" class="py-16 md:py-24 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.about_me'|trans }}</h2>
                </div>
                {% if aboutMe %}
                    <div class="flex flex-col md:flex-row items-center">
                        {% if aboutMe.profilePictureName %}
                            <div class="md:w-1/3 mb-8 md:mb-0 md:mr-10 text-center" data-aos="zoom-in" data-aos-delay="200">
                                <img src="{{ asset('uploads/images/about_me/' ~ aboutMe.profilePictureName) }}" alt="{{ 'common.profile_picture'|trans }}" class="rounded-full shadow-lg mx-auto h-48 w-48 md:h-64 md:w-64 object-cover">
                            </div>
                        {% endif %}
                        <div class="md:w-2/3" data-aos="fade-left" data-aos-delay="300">
                            <h3 class="text-2xl md:text-3xl font-semibold mb-4">{{ aboutMe.title|default('hero.passionate_developer'|trans) }}</h3>
                            <div class="prose lg:prose-lg max-w-none text-base-content mb-6">
                                {{ aboutMe.description|striptags|nl2br }}
                            </div>
                            <div data-aos="fade-up" data-aos-delay="400">
                                {% if aboutMe.cvFileName %}
                                    <a href="{{ asset('uploads/files/cv/' ~ aboutMe.cvFileName) }}" target="_blank" class="btn btn-primary mt-6">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                        {{ 'common.view_cv'|trans }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills" class="py-16 md:py-24 bg-base-100 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.skills'|trans }}</h2>
                </div>
                {% if skillCategories is not empty %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {% for category in skillCategories %}
                            <div class="card bg-base-200 shadow-xl" data-aos="zoom-in-up" data-aos-delay="{{ loop.index0 * 100 }}">
                                <div class="card-body">
                                    <h3 class="card-title text-xl md:text-2xl text-secondary">{{ category.name }}</h3> {# Category name from DB, not translated here #}
                                    <ul class="list-disc list-inside mt-2 space-y-1">
                                        {% for tech in category.technologies %}
                                            <li class="flex items-center">
                                                {% if tech.imageName %}
                                                    <img src="{{ asset('uploads/images/technologies/' ~ tech.imageName) }}" alt="{{ tech.name }}" class="h-6 w-6 mr-2 object-contain">
                                                {% else %}
                                                    <span class="h-6 w-6 mr-2 flex items-center justify-center text-accent">●</span>
                                                {% endif %}
                                                {{ tech.name }} {# Tech name from DB #}
                                                {% if tech.level %}
                                                    <span class="text-xs text-neutral-content ml-2">({{ tech.level }}/5)</span>
                                                {% endif %}
                                            </li>
                                        {% else %}
                                            <li>{{ 'common.no_items_category'|trans }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Soft Skills Section -->
        <section id="soft-skills" class="py-16 md:py-24">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.soft_skills'|trans }}</h2>
                </div>
                {% if softSkills is not empty %}
                    <div class="flex flex-wrap justify-center gap-4 md:gap-6">
                        {% for softSkill in softSkills %}
                            <div class="card card-compact w-72 bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
                                <div class="card-body items-center text-center">
                                    {% if softSkill.icon %}
                                        <span class="text-3xl text-accent mb-2"><i class="{{ softSkill.icon }}"></i></span>
                                    {% endif %}
                                    <h3 class="card-title text-lg">{{ softSkill.name }}</h3> {# From DB #}
                                    {% if softSkill.description %}
                                        <p class="text-sm text-base-content opacity-70">{{ softSkill.description }}</p> {# From DB #}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Projects Preview Section -->
        <section id="projects" class="py-16 md:py-24 scroll-mt-16 bg-base-100"> {# Added bg-base-100 for contrast #}
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.recent_projects'|trans }}</h2>
                </div>
                {% if projects is not empty %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {% for project in projects %}
                            <div class="card bg-base-100 shadow-xl image-full transform hover:scale-105 transition-transform duration-300" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 150 }}">
                                <figure><img src="{{ project.mainImageName ? asset('uploads/images/projects/' ~ project.mainImageName) : 'https://picsum.photos/seed/' ~ project.id ~ '/400/225' }}" alt="{{ 'common.main_project_image_alt'|trans({'%title%': project.title}) }}" class="object-cover h-full w-full"/></figure>
                                <div class="card-body justify-end">
                                    <div class="bg-black bg-opacity-40 p-4 rounded-md">
                                        <h3 class="card-title text-2xl text-white">{{ project.title }}</h3> {# Project title from DB #}
                                        <p class="text-gray-300 mb-2 text-sm">{{ project.description|striptags|slice(0, 80) }}{% if project.description|striptags|length > 80 %}...{% endif %}</p> {# Project desc from DB #}
                                        <div class="card-actions justify-start">
                                            <a href="{{ path('app_project_show_by_id', {id: project.id}) }}" class="btn btn-primary btn-sm">{{ 'common.see_more'|trans }}</a>
                                            {% if project.url %}
                                                <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">{{ 'project.live_site'|trans }}</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="text-center mt-12" data-aos="fade-up">
                        <a href="{{ path('app_project_index') }}" class="btn btn-outline btn-primary btn-lg">{{ 'sections.view_all_projects'|trans }}</a>
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_projects_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Experience & Education Timeline Section -->
        <section id="experience" class="py-16 md:py-24 bg-base-100 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.journey'|trans }}</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    <div data-aos="fade-right" data-aos-delay="200">
                        <h3 class="text-2xl md:text-3xl font-semibold text-secondary mb-8 text-center md:text-left">{{ 'sections.professional_experiences'|trans }}</h3>
                        {% if experiences is not empty %}
                            <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
                                {% for exp in experiences %}
                                    <li data-aos="fade-up" data-aos-offset="50" data-aos-delay="{{ loop.index0 * 100 }}">
                                        <div class="timeline-middle">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-primary"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div class="{% if loop.index is odd %}timeline-start md:text-end{% else %}timeline-end{% endif %} mb-10 p-1">
                                            <time class="font-mono italic text-sm">{{ exp.startDate|date('M Y') }} - {{ exp.isCurrent ? ('common.present'|trans) : exp.endDate|date('M Y') }}</time>
                                            <div class="text-lg md:text-xl font-black">{{ exp.jobTitle }}</div> {# From DB #}
                                            <div class="text-md md:text-lg font-semibold text-accent">{{ exp.company }}</div> {# From DB #}
                                            {% if exp.description %}
                                                <div class="text-sm mt-1 prose prose-sm max-w-none">{{ exp.description|striptags|nl2br }}</div> {# From DB #}
                                            {% endif %}
                                        </div>
                                        {% if not loop.last %}<hr/>{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p data-aos="fade-up">{{ 'common.no_experiences_default'|trans }}</p>
                        {% endif %}
                    </div>

                    <div data-aos="fade-left" data-aos-delay="300">
                        <h3 class="text-2xl md:text-3xl font-semibold text-secondary mb-8 text-center md:text-left">{{ 'sections.education'|trans }}</h3>
                        {% if educations is not empty %}
                            <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
                                {% for edu in educations %}
                                    <li data-aos="fade-up" data-aos-offset="50" data-aos-delay="{{ loop.index0 * 100 }}">
                                        <div class="timeline-middle">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-primary"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div class="{% if loop.index is odd %}timeline-start md:text-end{% else %}timeline-end{% endif %} mb-10 p-1">
                                            <time class="font-mono italic text-sm">{{ edu.startDate|date('Y') }} - {{ edu.endDate ? edu.endDate|date('Y') : ('common.ongoing'|trans) }}</time>
                                            <div class="text-lg md:text-xl font-black">{{ edu.degree }}</div> {# From DB #}
                                            <div class="text-md md:text-lg font-semibold text-accent">{{ edu.institution }}</div> {# From DB #}
                                            {% if edu.description %}
                                                <div class="text-sm mt-1 prose prose-sm max-w-none">{{ edu.description|striptags|nl2br }}</div> {# From DB #}
                                            {% endif %}
                                        </div>
                                        {% if not loop.last %}<hr/>{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p data-aos="fade-up">{{ 'common.no_educations_default'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <!-- Hobbies Section -->
        {% if hobbies is not empty %}
            <section id="hobbies" class="py-16 md:py-24 scroll-mt-16">
                <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.hobbies'|trans }}</h2>
                    </div>
                    <div class="flex flex-wrap justify-center gap-4">
                        {% for hobby in hobbies %}
                            <div class="badge badge-lg badge-outline p-4" data-aos="zoom-in" data-aos-delay="{{ loop.index0 * 100 }}">
                                {% if hobby.icon and hobby.icon starts with '<svg' %}
                                    {{ hobby.icon|raw }} {# Assuming direct SVG code for icon #}
                                {% elseif hobby.icon %}
                                    <i class="{{ hobby.icon }} mr-2"></i> {# Assuming FontAwesome class #}
                                {% endif %}
                                {{ hobby.name }} {# Hobby name from DB #}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}

        <!-- Contact Section -->
        <section id="contact" class="py-16 md:py-24 bg-base-300 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.contact_me'|trans }}</h2>
                    <p class="mt-4 text-lg text-base-content">{{ 'sections.contact_prompt'|trans }}</p>
                </div>
                <div class="max-w-2xl mx-auto card bg-base-100 shadow-xl" data-aos="zoom-in" data-aos-delay="200">
                    <div class="card-body">
                        {{ form_start(contactForm, {attr: {action: path('app_home') ~ '#contact'}}) }}
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.name, 'form.contact.name'|trans) }}
                            {{ form_widget(contactForm.name) }}
                            {{ form_errors(contactForm.name) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.email, 'form.contact.email'|trans) }}
                            {{ form_widget(contactForm.email) }}
                            {{ form_errors(contactForm.email) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.subject, 'form.contact.subject'|trans) }}
                            {{ form_widget(contactForm.subject) }}
                            {{ form_errors(contactForm.subject) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.message, 'form.contact.message'|trans) }}
                            {{ form_widget(contactForm.message) }}
                            {{ form_errors(contactForm.message) }}
                        </div>
                        <div class="card-actions justify-end">
                            <button type="submit" class="btn btn-primary">{{ 'form.contact.send'|trans }}</button>
                        </div>
                        {{ form_end(contactForm) }}
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer footer-center p-10 bg-base-200 text-base-content rounded" data-aos="fade-up" data-aos-anchor-placement="top-bottom">
            <div class="grid grid-flow-col gap-4">
                <a href="#about" class="link link-hover">{{ 'navbar.about'|trans }}</a>
                <a href="#projects" class="link link-hover">{{ 'navbar.projects'|trans }}</a>
                <a href="#contact" class="link link-hover">{{ 'navbar.contact'|trans }}</a>
            </div>
            <div>
                {# Social media icons placeholder #}
                <div class="grid grid-flow-col gap-4">
                    <a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-.422.724-.665 1.56-.665 2.455 0 1.613.823 3.043 2.074 3.863-.766-.024-1.483-.233-2.11-.583v.06A4.808 4.808 0 005.46 16.13c-.403.11-.83.17-1.274.17-.323 0-.636-.031-.942-.086.445 1.495 1.723 2.586 3.245 2.617-1.517 1.191-3.442 1.898-5.526 1.898-.358 0-.711-.021-1.059-.061 1.958 1.257 4.295 1.993 6.794 1.993 8.148 0 12.6-6.753 12.6-12.601 0-.192-.004-.383-.012-.573A9.007 9.007 0 0024 4.557z"></path></svg></a>
                    <a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"></path></svg></a>
                    <a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"></path></svg></a>
                </div>
            </div>
            <div>
                <p>Copyright {{ 'now'|date('Y') }} - {{ 'footer.copyright_by'|trans }}
                    {% if app.user and app.user.firstName and app.user.lastName %}
                        {{ app.user.firstName }} {{ app.user.lastName }}
                    {% elseif aboutMe.title is defined and aboutMe.title is not empty %}
                        {{ aboutMe.title|split(' - ')|first }}
                    {% else %}
                        {{ 'footer.your_name_here'|trans }}
                    {% endif %}
                </p>
                <p><small>{{ 'footer.powered_by'|trans }}</small></p>
            </div>
        </footer>

    </div>
{% endblock %}
