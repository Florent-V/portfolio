{% extends 'base.html.twig' %}

{% block title %}
    {% if aboutMe.title is defined and aboutMe.title is not empty %}
        {{ aboutMe.title|split(' - ')|first }} - Portfolio
    {% else %}
        {{ 'common.default_portfolio_title'|trans }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="bg-base-200 text-base-content">

        <!-- Hero + About Me Section fusionnées -->
        <section id="hero"
                 class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-gradient-to-br from-base-100 to-base-200 relative overflow-hidden">
            <!-- Éléments décoratifs en arrière-plan -->
            <div class="absolute inset-0 opacity-5">
                <div class="absolute top-20 left-10 w-72 h-72 bg-primary rounded-full mix-blend-multiply filter blur-xl animate-pulse"></div>
                <div class="absolute top-40 right-10 w-72 h-72 bg-secondary rounded-full mix-blend-multiply filter blur-xl animate-pulse"
                     style="animation-delay: 2s;"></div>
                <div class="absolute bottom-20 left-1/3 w-72 h-72 bg-accent rounded-full mix-blend-multiply filter blur-xl animate-pulse"
                     style="animation-delay: 4s;"></div>
            </div>

            <div class="container mx-auto px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

                    <!-- Colonne gauche : Photo et éléments visuels -->
                    <div class="m-auto order-2 lg:order-1" data-aos="fade-right" data-aos-duration="1000">
                        <div class="relative">
                            {% if aboutMe and aboutMe.profilePictureName %}
                                <!-- Photo de profil avec effets -->
                                <div class="relative mx-auto lg:mx-0 w-80 h-80 group">
                                    <div class="absolute inset-0 bg-gradient-to-r from-primary to-secondary rounded-full blur-lg opacity-75 group-hover:opacity-100 transition duration-1000 animate-pulse"></div>
                                    <img src="{{ asset('uploads/images/about_me/' ~ aboutMe.profilePictureName) }}"
                                         alt="{{ 'common.profile_picture'|trans }}"
                                         class="relative rounded-full shadow-2xl w-full h-full object-cover ring-4 ring-base-300 group-hover:ring-primary transition-all duration-500 transform group-hover:scale-105">
                                </div>
                                <!-- Badge flottant -->
                                <div class="absolute -bottom-6 -right-6 animate-bounce">
                                    <div class="badge badge-primary badge-lg p-4 shadow-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                        </svg>
                                    </div>
                                </div>
                            {% else %}
                                <!-- Placeholder si pas de photo -->
                                <div class="relative mx-auto lg:mx-0 w-80 h-80">
                                    <div class="w-full h-full bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center shadow-2xl">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-32 w-32 text-primary-content"
                                             fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Colonne droite : Contenu textuel -->
                    <div class="order-1 lg:order-2 text-center lg:text-left" data-aos="fade-left"
                         data-aos-duration="1000" data-aos-delay="200">

                        <!-- Badge de statut -->
                        <div class="mb-6" data-aos="fade-up" data-aos-delay="300">
                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-success/20 text-base-content/80 dark:text-success ring-1 ring-success/30">
                                <div class="w-2 h-2 bg-success rounded-full mr-2 animate-pulse"></div>
                                {{ 'hero.available_for_work'|trans|default('Disponible pour de nouveaux défis') }}
                            </span>
                        </div>

                        <!-- Titre principal -->
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-base-content mb-6 leading-tight"
                            data-aos="fade-up" data-aos-delay="400">
                            {% if aboutMe.title is defined and aboutMe.title is not empty %}
                                <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                                    {{ aboutMe.title }}
                                </span>
                            {% else %}
                                <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                                    {{ 'hero.welcome_default'|trans }}
                                </span>
                            {% endif %}
                        </h1>

                        <!-- Description détaillée -->
                        <div class="mb-8" data-aos="fade-up" data-aos-delay="500">
                            {% if aboutMe.description is defined and aboutMe.description is not empty %}
                                <div class="prose lg:prose-lg max-w-none text-base-content/80 leading-relaxed">
                                    {{ aboutMe.description|striptags|nl2br }}
                                </div>
                            {% else %}
                                <p class="text-lg lg:text-xl text-base-content/80 leading-relaxed">
                                    {{ 'hero.passionate_developer'|trans }}
                                </p>
                            {% endif %}
                        </div>

                        <!-- Statistiques rapides -->
                        <div class="grid grid-cols-3 gap-4 mb-8" data-aos="fade-up" data-aos-delay="600">
                            <div class="stat bg-base-100/50 rounded-2xl p-4 backdrop-blur-sm">
                                <div class="stat-value text-2xl text-primary">{{ aboutMe.yearsExperience|default('5+') }}</div>
                                <div class="stat-desc text-sm">{{ 'hero.years_experience'|trans }}</div>
                            </div>
                            <div class="stat bg-base-100/50 rounded-2xl p-4 backdrop-blur-sm">
                                <div class="stat-value text-2xl text-secondary">{{ projects|length|default('10+') }}</div>
                                <div class="stat-desc text-sm">{{ 'hero.projects_completed'|trans }}</div>
                            </div>
                            <div class="stat bg-base-100/50 rounded-2xl p-4 backdrop-blur-sm">
                                <div class="stat-value text-2xl text-accent">100%</div>
                                <div class="stat-desc text-sm">{{ 'hero.client_satisfaction'|trans }}</div>
                            </div>
                        </div>

                        <!-- Boutons d'action -->
                        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up"
                             data-aos-delay="700">
                            <a href="#contact" class="btn btn-primary btn-lg group">
                                {{ 'hero.get_in_touch'|trans|default('Me contacter') }}
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </a>

                            {% if aboutMe.cvFileName is defined and aboutMe.cvFileName is not null %}
                                <a href="{{ asset('uploads/files/cv/' ~ aboutMe.cvFileName) }}" target="_blank"
                                   class="btn btn-outline btn-secondary btn-lg group">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-5 w-5 mr-2 group-hover:scale-110 transition-transform" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    {{ 'hero.download_cv'|trans }}
                                </a>
                            {% else %}
                                <a href="#projects" class="btn btn-outline btn-secondary btn-lg group">
                                    {{ 'hero.view_projects'|trans|default('Voir mes projets') }}
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-5 w-5 ml-2 group-hover:translate-y-1 transition-transform" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                                    </svg>
                                </a>
                            {% endif %}
                        </div>

                        <!-- Liens sociaux -->
                        {% if socialLinks is defined and socialLinks is not empty %}
                            <div class="flex justify-center lg:justify-start gap-4 mt-8" data-aos="fade-up" data-aos-delay="800">
                                {% for social in socialLinks %}
                                    <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer"
                                       class="btn btn-circle btn-ghost hover:btn-primary transition-all duration-300 group"
                                       title="{{ social.name }}">
                                        <twig:ux:icon name="{{ social.icon }}" height="24" width="24" class="group-hover:scale-110 transition-transform duration-300" />
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Indicateur de scroll -->
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce" data-aos="fade-up"
                 data-aos-delay="1000">
                <a href="#skills" class="text-base-content/60 hover:text-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </a>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills" class="py-16 md:py-24 bg-base-100 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.skills'|trans }}</h2>
                </div>
                {% if skillCategories is not empty %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {% for category in skillCategories %}
                            <div class="card bg-base-200 shadow-xl" data-aos="zoom-in-up"
                                 data-aos-delay="{{ loop.index0 * 100 }}">
                                <div class="card-body">
                                    <h3 class="card-title text-xl md:text-2xl text-secondary">
                                        <twig:ux:icon name="{{ category.icon }}" height="24" width="24" class="mr-2" />
                                        {{ category.name }}
                                    </h3>
                                    <ul class="list-disc list-inside mt-2 space-y-1">
                                        {% for tech in category.technologies %}
                                            <li class="flex items-center">
                                                {% if tech.imageName %}
                                                    <img src="{{ asset('uploads/images/technologies/' ~ tech.imageName) }}"
                                                         alt="{{ tech.name }}" class="h-6 w-6 mr-2 object-contain">
                                                {% else %}
                                                    <span class="h-6 w-6 mr-2 flex items-center justify-center text-accent">●</span>
                                                {% endif %}
                                                {{ tech.name }} {# Tech name from DB #}
{# {% if tech.level %} #}
{# <span class="text-xs text-neutral-content ml-2">({{ tech.level }}/5)</span> #}
{# {% endif %} #}
                                            </li>
                                        {% else %}
                                            <li>{{ 'common.no_items_category'|trans }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Soft Skills Section -->
        <section id="soft-skills" class="py-16 md:py-24">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.soft_skills'|trans }}</h2>
                </div>
                {# #}{# old way #}
                {# {% if softSkills is not empty %} #}
                {# <div class="flex flex-wrap justify-center gap-4 md:gap-6"> #}
                {# {% for softSkill in softSkills %} #}
                {# <div class="card card-compact w-72 bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}"> #}
                {# <div class="card-body items-center text-center"> #}
                {# {% if softSkill.icon %} #}
                {# <twig:ux:icon name="{{ softSkill.icon }}" height="32" width="32" class="me-2" /> #}
                {# <span class="text-3xl text-accent mb-2"><i class="{{ softSkill.icon }}"></i></span> #}
                {# {% endif %} #}
                {# <h3 class="card-title text-lg">{{ softSkill.name }}</h3>  From DB #}
                {# </div> #}
                {# </div> #}
                {# {% endfor %} #}
                {# </div> #}
                {# {% else %} #}
                {# <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p> #}
                {# {% endif %} #}
                {% if softSkills is not empty %}
                    <div class="rounded-lg" {{ vue_component('SoftSkills2', {
                        skills: softSkillsForVue,
                    }) }}></div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_items_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Projects Preview Section -->
        <section
                {{ stimulus_controller('adjustImageDisplay') }}
                id="projects"
                class="py-16 md:py-24 bg-base-100 scroll-mt-16"
        >
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.recent_projects'|trans }}</h2>
                </div>
                {% if projects is not empty %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {% for project in projects %}
                            <div class="card bg-base-100 shadow-xl transform hover:scale-105 transition-transform duration-300 relative overflow-hidden"
                                 data-aos="fade-up" data-aos-delay="{{ loop.index0 * 150 }}">
                                <figure class="aspect-[4/3] overflow-hidden bg-base-200">
                                    <img src="{{ project.mainImageName ? asset('uploads/images/projects/' ~ project.mainImageName) : 'https://picsum.photos/seed/' ~ project.id ~ '/400/225' }}"
                                         alt="{{ 'common.main_project_image_alt'|trans({'%title%': project.title}) }}"
                                         class="w-full h-full object-contain object-center project-image" />
                                </figure>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                <div class="absolute bottom-0 left-0 right-0 p-4">
                                    <div class="bg-black bg-opacity-40 p-4 rounded-md">
                                        <h3 class="text-2xl font-bold mb-2 text-white">{{ project.title }}</h3>
                                        <p class="text-gray-300 mb-4 text-sm">{{ project.description|striptags|slice(0, 80) }}{% if project.description|striptags|length > 80 %}...{% endif %}</p>
                                        <div class="flex gap-2">
                                            <a href="{{ path('app_project_show_by_id', {id: project.id}) }}"
                                               class="btn btn-primary btn-sm">{{ 'common.see_more'|trans }}</a>
                                            {% if project.url %}
                                                <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer"
                                                   class="btn btn-secondary btn-sm">{{ 'project.live_site'|trans|default('Voir en ligne') }}</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="text-center mt-12" data-aos="fade-up">
                        <a href="{{ path('app_project_index') }}"
                           class="btn btn-outline btn-primary btn-lg">{{ 'sections.view_all_projects'|trans }}</a>
                    </div>
                {% else %}
                    <p class="text-center text-lg" data-aos="fade-up">{{ 'common.no_projects_default'|trans }}</p>
                {% endif %}
            </div>
        </section>

        <!-- Experience & Education Timeline Section -->
        <section id="experience" class="py-16 md:py-24 bg-base-100 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.journey'|trans }}</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    <div data-aos="fade-right" data-aos-delay="200">
                        <h3 class="text-2xl md:text-3xl font-semibold text-secondary mb-8 text-center md:text-left">{{ 'sections.professional_experiences'|trans }}</h3>
                        {% if experiences is not empty %}
                            <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
                                {% for exp in experiences %}
                                    <li data-aos="fade-up" data-aos-offset="50"
                                        data-aos-delay="{{ loop.index0 * 100 }}">
                                        <div class="timeline-middle">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor" class="h-5 w-5 text-primary">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                                                      clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                        <div class="{% if loop.index is odd %}timeline-start md:text-end{% else %}timeline-end{% endif %} mb-10 p-1">
                                            <time class="font-mono italic text-sm">{{ exp.startDate|date('M Y') }}
                                                - {{ exp.isCurrent ? ('common.present'|trans) : exp.endDate|date('M Y') }}</time>
                                            <div class="text-lg md:text-xl font-black">{{ exp.jobTitle }}</div> {# From DB #}
                                            <div class="text-md md:text-lg font-semibold text-accent">{{ exp.company }}</div> {# From DB #}
                                            {% if exp.description %}
                                                <div class="text-sm mt-1 prose prose-sm max-w-none">{{ exp.description|striptags|nl2br }}</div> {# From DB #}
                                            {% endif %}
                                        </div>
                                        {% if not loop.last %}
                                            <hr />{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p data-aos="fade-up">{{ 'common.no_experiences_default'|trans }}</p>
                        {% endif %}
                    </div>

                    <div data-aos="fade-left" data-aos-delay="300">
                        <h3 class="text-2xl md:text-3xl font-semibold text-secondary mb-8 text-center md:text-left">{{ 'sections.education'|trans }}</h3>
                        {% if educations is not empty %}
                            <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
                                {% for edu in educations %}
                                    <li data-aos="fade-up" data-aos-offset="50"
                                        data-aos-delay="{{ loop.index0 * 100 }}">
                                        <div class="timeline-middle">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor" class="h-5 w-5 text-primary">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                                                      clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                        <div class="{% if loop.index is odd %}timeline-start md:text-end{% else %}timeline-end{% endif %} mb-10 p-1">
                                            <time class="font-mono italic text-sm">{{ edu.startDate|date('Y') }}
                                                - {{ edu.endDate ? edu.endDate|date('Y') : ('common.ongoing'|trans) }}</time>
                                            <div class="text-lg md:text-xl font-black">{{ edu.degree }}</div> {# From DB #}
                                            <div class="text-md md:text-lg font-semibold text-accent">{{ edu.institution }}</div> {# From DB #}
                                            {% if edu.description %}
                                                <div class="text-sm mt-1 prose prose-sm max-w-none">{{ edu.description|striptags|nl2br }}</div> {# From DB #}
                                            {% endif %}
                                        </div>
                                        {% if not loop.last %}
                                            <hr />{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p data-aos="fade-up">{{ 'common.no_educations_default'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <!-- Hobbies Section -->
        {% if hobbies is not empty %}
            <section id="hobbies" class="py-16 md:py-24 scroll-mt-16">
                <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.hobbies'|trans }}</h2>
                    </div>
                    <div class="flex flex-wrap justify-center gap-4">
                        {% for hobby in hobbies %}
                            <div class="badge badge-lg badge-outline p-4" data-aos="zoom-in"
                                 data-aos-delay="{{ loop.index0 * 100 }}">
                                {% if hobby.icon and hobby.icon starts with '<svg' %}
                                    {{ hobby.icon|raw }} {# Assuming direct SVG code for icon #}
                                {% elseif hobby.icon %}
                                    <i class="{{ hobby.icon }} mr-2"></i> {# Assuming FontAwesome class #}
                                {% endif %}
                                {{ hobby.name }} {# Hobby name from DB #}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}

        <!-- Contact Section -->
        <section id="contact" class="py-16 md:py-24 bg-base-300 scroll-mt-16">
            <div class="container mx-auto px-6 lg:px-8" data-aos="fade-up">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary">{{ 'sections.contact_me'|trans }}</h2>
                    <p class="mt-4 text-lg text-base-content">{{ 'sections.contact_prompt'|trans }}</p>
                </div>
                <div class="max-w-2xl mx-auto card bg-base-100 shadow-xl" data-aos="zoom-in" data-aos-delay="200">
                    <div class="card-body">
                        {{ form_start(contactForm, {attr: {action: path('app_home') ~ '#contact'}}) }}
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.name, 'form.contact.name'|trans) }}
                            {{ form_widget(contactForm.name) }}
                            {{ form_errors(contactForm.name) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.email, 'form.contact.email'|trans) }}
                            {{ form_widget(contactForm.email) }}
                            {{ form_errors(contactForm.email) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.subject, 'form.contact.subject'|trans) }}
                            {{ form_widget(contactForm.subject) }}
                            {{ form_errors(contactForm.subject) }}
                        </div>
                        <div class="form-control mb-4">
                            {{ form_label(contactForm.message, 'form.contact.message'|trans) }}
                            {{ form_widget(contactForm.message) }}
                            {{ form_errors(contactForm.message) }}
                        </div>
                        <div class="card-actions justify-end">
                            <button type="submit" class="btn btn-primary">{{ 'form.contact.send'|trans }}</button>
                        </div>
                        {{ form_end(contactForm) }}
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer footer-center p-10 bg-base-200 text-base-content rounded" data-aos="fade-up"
                data-aos-anchor-placement="top-bottom">
            <div class="grid grid-flow-col gap-4">
                <a href="#hero" class="link link-hover">{{ 'navbar.about'|trans }}</a>
                <a href="#projects" class="link link-hover">{{ 'navbar.projects'|trans }}</a>
                <a href="#contact" class="link link-hover">{{ 'navbar.contact'|trans }}</a>
            </div>
            <div>
                {# Social media icons placeholder #}
                <!-- Liens sociaux -->
                {% if socialLinks is defined and socialLinks is not empty %}
                    <div class="flex justify-center lg:justify-start gap-4" data-aos="fade-up" data-aos-delay="800">
                        {% for social in socialLinks %}
                            <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer"
                               class="btn btn-circle btn-ghost hover:btn-primary transition-all duration-300 group"
                               title="{{ social.name }}">
                                <twig:ux:icon name="{{ social.icon }}" height="24" width="24" class="group-hover:scale-110 transition-transform duration-300" />
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div>
                <p>Copyright {{ 'now'|date('Y') }} - {{ 'footer.copyright_by'|trans }}
                    {% if app.user and app.user.firstName and app.user.lastName %}
                        {{ app.user.firstName }} {{ app.user.lastName }}
                    {% elseif aboutMe.firstName is defined and aboutMe.firstName is not empty %}
                        {{ aboutMe.firstName }} {{ aboutMe.lastName }}
                    {% else %}
                        {{ 'footer.your_name_here'|trans }}
                    {% endif %}
                </p>
                <p>
                    <small>
                        {% if aboutMe.firstName is defined and aboutMe.firstName is not empty %}
                            {{ 'footer.made_by'|trans }} {{ aboutMe.firstName }} {{ aboutMe.lastName }}.
                        {% endif %}
                        {{ 'footer.powered_by'|trans }}
                    </small>
                </p>
            </div>
        </footer>

    </div>
{% endblock %}
