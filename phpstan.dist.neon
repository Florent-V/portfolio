parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
    excludePaths:
        - tests/
        - src/DataFixtures/
    # symplify/phpstan-rules ≥ 14.19 s'enregistre via extension-installer :
    # on n'active que les règles Symfony (comportement précédent).
    symplify:
        naming: false
        complexity: false
        configurable: false
        static: false
        modern: false
        symfony: true
        symfonyConfig: false
        doctrine: false
        collections: false
        phpunit: false
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
            - identifier: symfony.noClassLevelRoute
            - identifier: symplify.preferInterfaceInConstructor
